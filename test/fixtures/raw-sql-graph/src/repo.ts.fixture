declare function query(text: string, params?: unknown[]): Promise<any>;
declare const app: any;

export async function getUser(id: string) {
  return query(`SELECT * FROM users WHERE id = $1`, [id]);
}

export async function saveOrder(userId: string) {
  return query(`INSERT INTO orders (user_id) VALUES ($1)`, [userId]);
}

export async function yearly() {
  return query(`SELECT EXTRACT(YEAR FROM created) FROM orders o WHERE o.id IS DISTINCT FROM 0`);
}

// The table arrives as a parameter: its callers write the name out.
export async function countIn(table: string, column: string, value: string) {
  return query(`SELECT count(*) FROM ${table} WHERE ${column} = $1`, [value]);
}

// A list of records, each naming a table.
export async function blockers(checks: Array<{ table: string; column: string }>) {
  return Promise.all(checks.map((c) => query(`SELECT 1 FROM ${c.table} WHERE ${c.column} = $1`)));
}

export async function deleteUser(id: string) {
  await countIn('orders', 'user_id', id);
  await blockers([{ table: 'users', column: 'id' }]);
}

// A list another function hands back.
export function cleanupOrder() {
  return ['orders', 'users'];
}

export async function purge() {
  for (const t of cleanupOrder()) await query(`DELETE FROM ${t}`);
}

// A list written in the same function.
export async function wipeAll() {
  for (const t of ['orders', 'users']) await query(`TRUNCATE ${t}`);
}

// Nothing calls this one, so its table cannot be traced.
export async function fromAnywhere(name: string) {
  return query(`SELECT * FROM ${name}`);
}

// The table comes from the request itself.
app.get('/rows/:t', (req: any, res: any) => query(`SELECT * FROM ${req.params.t}`));

// UI text that only looks like SQL.
export function label(name: string, active: boolean) {
  const cls = `block truncate ${active ? 'on' : 'off'}`;
  return `Update ${name} now` + cls;
}
